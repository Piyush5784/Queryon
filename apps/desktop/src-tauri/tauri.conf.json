{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Queryon",
  "version": "0.2.1",
  "identifier": "com.piyush.queryon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Queryon",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/queryon/libduckdb.so": "target/duckdb-download/x86_64-unknown-linux-gnu/1.5.5/libduckdb.so"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/queryon/libduckdb.so": "target/duckdb-download/x86_64-unknown-linux-gnu/1.5.5/libduckdb.so"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQUQxQUVFNzQwQkYwRjUKUldUMThBdDA3aHF0R25WRHhkdTVDODhRdEM1L21KMHdBU21ZV1Y1c0M1TkErbmdER3pJbDJNUXgK",
      "endpoints": [
        "https://github.com/Piyush5784/Queryon/releases/latest/download/latest.json"
      ]
    }
  }
}
