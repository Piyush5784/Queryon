{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "detached",
  "description": "Capability for detached single-tab windows",
  "windows": ["detached-*"],
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:window:allow-close",
    "store:default",
    "dialog:default"
  ]
}
